{
  "manifest_version": 3,
  "name": "fogbank",
  "version": "0.1.0",
  "description": "Pseudonymise data in prompt and reverse it.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": [
        "content/site-adapters/generic.js",
        "content/pseudonyme.js",
        "content/mention-menu.js",
        "content/content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage"]
}
